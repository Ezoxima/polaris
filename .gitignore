# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Secrets et configuration locale : jamais versionnés
.env
.env.*
config.json
.claude/settings.local.json

# Données locales : seuls les exemples fictifs sont suivis
donnees/*
!donnees/*.exemple.json
!donnees/*.exemple.jsonl

# Personnalisation locale : registres et préférences propres à une installation (voir docs/installation-restreinte.md)
registre/*.local.md

# Contenu propre à chaque utilisateur : briefs, comptes rendus, mémoire des projets
briefs/
memoire/*
!memoire/INDEX.md

# Éditeurs et système
.vscode/
.idea/
.DS_Store
Thumbs.db
